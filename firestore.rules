rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // We allow unverified users for guest auth if we use anonymous auth. Let's just check auth != null
    // We'll use anonymous auth, so email_verified shouldn't be strictly required unless we use google sign in
    // The setup explicitly uses google sign in, but let's just stick to standard isSignedIn
    // Wait, the prompt says "For all standard write operations you MUST strictly mandate that the user is verified using request.auth.token.email_verified == true" UNLESS the app explicitly supports anonymous users.
    // I won't configure anonymous users, so I will enforce email_verified.
    // Wait, the Firebase project is just Google Sign In, so emails are verified.
    function isVerifiedUser() { return request.auth != null && request.auth.token.email_verified == true; }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['channelId', 'userId', 'username', 'text', 'timestamp']) &&
             // Optional fields avatarColor, badge
             data.keys().size() >= 5 && data.keys().size() <= 7 &&
             data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             data.timestamp == request.time &&
             (data.keys().hasAny(['avatarColor']) == false || (data.avatarColor is string && data.avatarColor.size() <= 200)) &&
             (data.keys().hasAny(['badge']) == false || (data.badge is string && data.badge.size() <= 32));
    }

    match /messages/{messageId} {
      allow read: if isVerifiedUser(); // Everyone verified can read messages
      allow create: if isVerifiedUser() && 
                    isValidId(messageId) && 
                    isValidChatMessage(incoming());
      // No updates or deletes for chat messages
    }
  }
}
