HOST="0.0.0.0"
PORT=3000
APP_URL="https://ais-dev-5jyezfwcybgi7odkwqvxt6-640543945523.asia-east1.run.app"
SITE_URL="https://ais-pre-5jyezfwcybgi7odkwqvxt6-640543945523.asia-east1.run.app"
VITE_API_BASE_URL=""

# --- Security & CORS Allowlist ---
