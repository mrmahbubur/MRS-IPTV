# ==============================================================================
# M R S IPTV — Environment Configuration Template
# Copy this file to .env and replace placeholders with real secrets before deploy.
# Never commit .env with production secrets to version control.
# ==============================================================================

# --- AI & Runtime App URL ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
SITE_URL="https://shahin-iptv.ai.studio"
VITE_API_BASE_URL=""
PORT=3000

# --- Security & CORS Allowlist ---
# Comma-separated list of allowed frontend origins for CORS
SITE_ORIGINS="http://localhost:3000,https://shahin-iptv.ai.studio"
TRUST_PROXY=0

# Secret keys (generate with: openssl rand -hex 32)
ADMIN_TOKEN="change-me-admin-token"
INGEST_KEY="change-me-ingest-key"
SMS_WEBHOOK_SECRET="change-me-sms-webhook-hmac-secret"
TOKEN_SECRET="change-me-hmac-session-secret"
INTERNAL_WEBHOOK_SECRET="change-me-internal-webhook-secret"

# --- Storage & SQLite Database ---
DB_PATH="data/mrs.sqlite"
UPLOAD_DIR="data/uploads"
MAX_SCREENSHOT_BYTES=3145728

# --- Activation Code Engine ---
CODE_FORMAT="mrs"
AUTO_REFILL_CODES=false
REFILL_BATCH=200
LOW_STOCK_THRESHOLD=50
DEFAULT_DEVICE_LIMIT=2
EXPIRY_FROM="activation"

# --- Verification Window & Anti-Abuse ---
ORDER_TTL_MINUTES=60
PENDING_TTL_HOURS=48
PAYMENT_MAX_AGE_HOURS=72
AMOUNT_TOLERANCE_PCT=0
EMAIL_MX_CHECK=true
MAX_ORDERS_PER_EMAIL_PER_DAY=6

# --- SMTP Email Delivery (Nodemailer) ---
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username@gmail.com"
SMTP_PASS="your-app-password-here"
MAIL_FROM="M R S IPTV <your-smtp-username@gmail.com>"
MAIL_REPLY_TO="your-smtp-username@gmail.com"
ADMIN_EMAIL="mr216873@gmail.com"
SEND_SUBMISSION_COPY=true
MAIL_MAX_ATTEMPTS=8

# --- Receiving Payment Accounts (Served dynamically via /api/payment-methods) ---
RECEIVING_BKASH="01810853282"
RECEIVING_BKASH_TYPE="Personal (Send Money)"
RECEIVING_NAGAD="+8801792322734"
RECEIVING_NAGAD_TYPE="Personal (Send Money)"
RECEIVING_BINANCE_UID="38927942"
RECEIVING_BINANCE_ID="mrxshahin"
RECEIVING_SKRILL="407108385"
RECEIVING_SKRILL_EMAIL=""
RECEIVING_PAYONEER="108003450"

# --- Payment Provider Webhooks & APIs (Optional Official Merchant Integrations) ---
BKASH_MERCHANT_ENABLED=false
BKASH_WEBHOOK_SECRET=""
BKASH_SMS_SENDERS="bKash"

NAGAD_MERCHANT_ENABLED=false
NAGAD_WEBHOOK_SECRET=""
NAGAD_SMS_SENDERS="NAGAD,Nagad"

BINANCE_WEBHOOK_ENABLED=false
BINANCE_WEBHOOK_SECRET=""
BINANCE_WEBHOOK_PUBLIC_KEY=""
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_API_BASE="https://api.binance.com"
BINANCE_POLL_SECONDS=60
BINANCE_LOOKBACK_HOURS=72
BINANCE_ORDER_TYPES="C2C,PAY"
BINANCE_ACCEPTED_ASSETS="USDT,USDC,FDUSD,BUSD,USD"
BINANCE_NICKNAME_AUTO=false

SKRILL_WEBHOOK_ENABLED=false
SKRILL_MERCHANT_ID=""
SKRILL_SECRET_WORD=""
SKRILL_PAY_TO_EMAIL=""
SKRILL_EMAIL_DOMAINS="skrill.com"

PAYONEER_WEBHOOK_ENABLED=false
PAYONEER_WEBHOOK_SECRET=""
PAYONEER_EMAIL_DOMAINS="payoneer.com"
INGEST_REQUIRE_DKIM=true

# --- Support Contact Channels ---
SUPPORT_WHATSAPP="+8801810853282"
SUPPORT_TELEGRAM="https://t.me/mrsiptv"
SUPPORT_FACEBOOK="https://facebook.com/mrsiptv"

# --- Real Live-Channel Checker & Verifier ---
SOURCES_FILE="data/sources.json"
CHECK_CONCURRENCY=4
CHECK_TIMEOUT_MS=5000
LIVE_RECHECK_MIN=10
DEAD_RECHECK_MIN=360
FAIL_THRESHOLD=2
FRESHNESS_CHECK=true
FRESHNESS_MAX_WAIT_MS=12000
ACCEPT_VOD=false
ALLOW_PRIVATE_NETWORKS=false
CHECK_TICK_SEC=30
CHECK_BATCH=40
CHECK_PER_HOST=1
CHECK_BATCH_SLEEP_MS=2000
CHECK_USER_AGENT="VLC/3.0.20 LibVLC/3.0.20"

# --- Channel Health & Rights Compliance Policy ---
LIVECHECK_SCHEDULER=1
TRUST_CDN_GEO=0
BLOCKED_SOURCE_HOSTS=""
REQUIRE_LICENSE_ATTESTATION=1
HEALTH_FRESH_MS=21600000
HEALTH_REQUIRE_FRESH=1
HEALTH_FAIL_THRESHOLD=2
HEALTH_CONCURRENCY=4
HEALTH_PER_HOST=1
HEALTH_BATCH=40
HEALTH_BUDGET_MS=120000
HEALTH_ALLOW_VOD=0

# --- Autonomous Site Control & Signing ---
CAMELLIA_TOKEN=""
SECURITY_SECRET=""
BILLING_URL="http://127.0.0.1:3000"
BILLING_PAY_KEY=""
BILLING_READ_KEY=""

# --- Cloudinary API Integration (scripts/cloudinary.mjs) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_COLLECTION_ID=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_FOLDER="mrs-iptv"

