# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=8787
# Behind Render/Railway/nginx/Cloudflare set 1 so rate limits see the real client IP
TRUST_PROXY=1

# Where the SQLite file + uploaded screenshots live. MUST be on a persistent disk.
DB_PATH=data/mrs.sqlite
UPLOAD_DIR=data/uploads

# Browsers allowed to call the API (your site; add the Median/other origins if needed). Comma separated.
SITE_ORIGINS=https://shahin-iptv.ai.studio
SITE_URL=https://shahin-iptv.ai.studio
SUPPORT_WHATSAPP=+8801810853282

# ---- Secrets: each at least 32 random chars. Generate with:  openssl rand -hex 32
ADMIN_TOKEN=
INGEST_KEY=
TOKEN_SECRET=

# ---- E-mail (activation codes). Any SMTP provider: Brevo, Resend, Amazon SES, Mailgun, Gmail app password…
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=M R S IPTV <no-reply@your-domain.com>
MAIL_REPLY_TO=

# ---- Binance Pay (READ-ONLY API key, restrict it to your server's IP in Binance). Leave blank to skip.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_POLL_SECONDS=60
# Binance assets counted as 1 USD each
BINANCE_ACCEPTED_ASSETS=USDT,USDC,FDUSD,BUSD,USD
# false = a payer-nickname-only claim goes to manual review (recommended; nicknames are not secret)
BINANCE_NICKNAME_AUTO=false

# ---- SMS sender IDs shown by your phone for the wallet apps (check the real names in your inbox)
BKASH_SMS_SENDERS=bKash
NAGAD_SMS_SENDERS=NAGAD,Nagad

# ---- Policy
EXPIRY_FROM=activation          # activation = plan starts when the code is redeemed | issue = starts at payment
PENDING_TTL_HOURS=48            # how long an order waits for its payment to appear
PAYMENT_MAX_AGE_HOURS=72        # payments older than this vs. the order → manual review
AMOUNT_TOLERANCE_PCT=0          # allow e.g. 2 if a provider deducts a small fee before you see the amount
AUTO_REFILL_CODES=true          # create fresh codes automatically if a pool runs dry
EMAIL_MX_CHECK=true
INGEST_REQUIRE_DKIM=true
